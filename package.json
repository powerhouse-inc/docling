{
  "name": "@powerhousedao/docling-service",
  "version": "0.1.0",
  "description": "Document-conversion HTTP service over docling.rs. Deployed as its own container and reached over CONVERT_SERVICE_URL.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/server.ts",
    "fetch-models": "node src/fetch-models.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docker:build": "docker build -t docling-service .",
    "docker:run": "docker run --rm -p 5011:5011 -v docling-models:/models -e DOCLING_RS_HOME=/models docling-service"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "optionalDependencies": {
    "docling.rs": "^1.55.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "4.1.1",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^5.9.3",
    "vitest": "4.1.1"
  }
}
