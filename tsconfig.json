{
  "compilerOptions": {
    "rootDir": ".",
    "module": "nodenext",
    "moduleDetection": "force",
    "target": "esnext",
    "types": ["node", "vitest/globals"],
    "lib": ["ESNext"],
    "noEmit": true,
    "incremental": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
